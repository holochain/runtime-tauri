{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{productName}}",
  "version": "{{version}}",
  "identifier": "{{identifier}}",
  "build": {
    "beforeBuildCommand": "npm run build -w {{uiWorkspace}}",
    "devUrl": "http://localhost:{{uiPort}}",
    "frontendDist": "../{{uiWorkspace}}/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
